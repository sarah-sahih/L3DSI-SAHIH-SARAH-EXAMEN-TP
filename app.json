{
  "expo": {
    "name": "tp3",
    "slug": "tp3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mytasks.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Autorisez MyTasks a acceder a votre appareil photo.",
          "photosPermission": "Autorisez MyTasks a acceder a vos photos.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez MyTasks a verifier les rappels a proximite.",
          "locationAlwaysAndWhenInUsePermission": "Autorisez MyTasks a verifier les rappels a proximite.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "fc249d0e-72d3-4f22-8644-42416dffd7ef"
      }
    }
  }
}
